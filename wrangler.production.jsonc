{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "corex-server-v3",
    "main": "main.js",
    "compatibility_date": "2026-11-06",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,

    "vars": {
        "PUBLIC_BASE_URL": "https://corex-server-v3.corex-services.workers.dev"
    },

    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/",
            "/index.html",
            "/dashboard.html",
            "/login.html",
            "/api/*",
            "/auth/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "corex-db-v3-production",
            "database_id": "7083f2f9-f960-4fba-8e23-916f040818f4",
            "migrations_dir": "db/migrations"
        }
    ],
    "ratelimits": [
        {
            "name": "AUTH_SESSION_LIMITER",
            "namespace_id": "68422101",
            "simple": { "limit": 10, "period": 60 }
        },
        {
            "name": "AUTH_POLL_LIMITER",
            "namespace_id": "68422104",
            "simple": { "limit": 120, "period": 60 }
        },
        {
            "name": "CALLBACK_LIMITER",
            "namespace_id": "68422102",
            "simple": { "limit": 120, "period": 60 }
        },
        {
            "name": "ADMIN_LOGIN_LIMITER",
            "namespace_id": "68422103",
            "simple": { "limit": 5, "period": 60 }
        },
        {
            "name": "ADMIN_CLIENT_CREATE_LIMITER",
            "namespace_id": "68422105",
            "simple": { "limit": 5, "period": 60 }
        }
    ],
    "triggers": {
        "crons": ["* * * * *"]
    }
}
