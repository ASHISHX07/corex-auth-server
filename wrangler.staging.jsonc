{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "corex-server-v3-staging",
    "main": "main.js",
    "compatibility_date": "2026-11-06",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,

    "vars": {
    	"PUBLIC_BASE_URL": "https://corex-server-v3-staging.corex-services.workers.dev"
    },

    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/",
            "/index.html",
            "/dashboard.html",
            "/login.html",
            "/api/*",
            "/auth/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "corex-db-staging",
            "database_id": "7d6b918f-6d05-4e2c-a200-8a9682e89bd6",
            "migrations_dir": "db/migrations"
        }
    ],
    "ratelimits": [
        {
            "name": "AUTH_SESSION_LIMITER",
            "namespace_id": "68421101",
            "simple": { "limit": 10, "period": 60 }
        },
        {
            "name": "AUTH_POLL_LIMITER",
            "namespace_id": "68421104",
            "simple": { "limit": 120, "period": 60 }
        },
        {
            "name": "CALLBACK_LIMITER",
            "namespace_id": "68421102",
            "simple": { "limit": 120, "period": 60 }
        },
        {
            "name": "ADMIN_LOGIN_LIMITER",
            "namespace_id": "68421103",
            "simple": { "limit": 5, "period": 60 }
        },
        {
            "name": "ADMIN_CLIENT_CREATE_LIMITER",
            "namespace_id": "68421105",
            "simple": { "limit": 5, "period": 60 }
        }
    ],
    "triggers": {
        "crons": ["* * * * *"]
    }
}
