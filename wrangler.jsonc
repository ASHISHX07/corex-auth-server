{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "corex-auth-server",
    "main": "main.js",
    "compatibility_date": "2026-10-15",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "rules": [
        { "type": "ESModule", "globs": ["**/*.js"] }
    ],
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*",
            "/auth/*"
        ]
    }
}